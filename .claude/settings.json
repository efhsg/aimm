{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git rev-parse:*)",
      "Bash(git check-ignore:*)",
      "Bash(git ls-files:*)",
      "Bash(grep:*)",
      "Bash(jq empty:*)",
      "Bash(readlink:*)",
      "Bash(realpath:*)",
      "Bash(test:*)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git pull --rebase:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git push --delete:*)",
      "Bash(docker exec aimm_yii php yii migrate/fresh:*)",
      "Bash(docker exec aimm_yii php yii migrate/down:*)",
      "Bash(docker exec aimm_yii php yii db/reset:*)",
      "Bash(docker exec aimm_yii php yii squash-migrations:*)"
    ]
  }
}
